{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:browser": "npm run engine && EIS_HOST=browser vite",
    "engine": "python3 ../scripts/build_engine_wheel.py --out public/engine && python3 ../scripts/stage_pyodide.py --out public/pyodide",
    "build": "tsc -b && vite build",
    "build:browser": "python3 ../scripts/build_site.py --out dist",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "build:site": "python3 ../scripts/build_site.py --out ../_site"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.6",
    "@fontsource/ibm-plex-sans": "5.2.6",
    "echarts": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "pyodide": "0.28.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
