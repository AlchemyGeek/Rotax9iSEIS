{
  "version": "1.2",
  "rules": {
    "egt_spread": {
      "enabled": true,
      "triggers": [
        {
          "type": "baseline_deviation",
          "n_min": 10,
          "severity": "watch"
        },
        {
          "type": "trend",
          "direction": "increasing",
          "r2_min": 0.5,
          "n_min": 10,
          "severity": "watch"
        }
      ]
    },
    "egt4_elevation": {
      "_comment": "Deprecated (Spec 08): superseded by egt_cyl_deviation, which covers cylinder 4 and the others. Kept disabled for one minor version.",
      "enabled": false,
      "triggers": [
        {
          "type": "baseline_deviation",
          "n_min": 10,
          "severity": "watch"
        },
        {
          "type": "trend",
          "direction": "increasing",
          "r2_min": 0.5,
          "n_min": 10,
          "severity": "watch"
        }
      ]
    },
    "egt_cyl_deviation": {
      "enabled": true,
      "applies_to": ["egt1_deviation", "egt2_deviation", "egt3_deviation", "egt4_deviation"],
      "triggers": [
        {
          "type": "baseline_deviation",
          "n_min": 10,
          "severity": "watch"
        },
        {
          "type": "trend",
          "direction": "either",
          "r2_min": 0.5,
          "n_min": 10,
          "severity": "watch"
        }
      ]
    },
    "cylinder_rank": {
      "enabled": true,
      "triggers": [
        {
          "type": "threshold",
          "condition": "hot_cyl_changed",
          "margin_min_f": 15,
          "consecutive_flights": 2,
          "severity": "warning"
        }
      ]
    },
    "oil_temp_peak": {
      "enabled": true,
      "triggers": [
        {
          "type": "threshold",
          "limit": 248,
          "unit": "f",
          "severity": "limit"
        },
        {
          "type": "baseline_deviation",
          "n_min": 10,
          "severity": "watch"
        }
      ]
    },
    "coolant_temp_peak": {
      "enabled": true,
      "triggers": [
        {
          "type": "threshold",
          "limit": 248,
          "unit": "f",
          "severity": "limit"
        },
        {
          "type": "baseline_deviation",
          "n_min": 10,
          "severity": "watch"
        }
      ]
    },
    "oil_coolant_ratio": {
      "enabled": true,
      "triggers": [
        {
          "type": "baseline_deviation",
          "n_min": 10,
          "severity": "watch"
        }
      ]
    },
    "overboost_time": {
      "enabled": true,
      "triggers": [
        {
          "type": "threshold",
          "limit": 300,
          "unit": "s",
          "severity": "limit"
        }
      ]
    },
    "cruise_efficiency": {
      "enabled": true,
      "triggers": [
        {
          "type": "baseline_deviation",
          "n_min": 10,
          "severity": "watch"
        },
        {
          "type": "trend",
          "direction": "decreasing",
          "r2_min": 0.5,
          "n_min": 10,
          "severity": "watch"
        }
      ]
    },
    "cruise_fuel_flow": {
      "enabled": true,
      "triggers": [
        {
          "type": "baseline_deviation",
          "n_min": 10,
          "severity": "watch"
        }
      ]
    },
    "map_at_takeoff": {
      "enabled": true,
      "triggers": [
        {
          "type": "threshold",
          "condition": "vs_om_expected",
          "tolerance_hpa": 20,
          "severity": "warning"
        }
      ]
    },
    "engine_ecu_inflight": {
      "enabled": true,
      "triggers": [
        {
          "type": "threshold",
          "condition": "any_inflight",
          "severity": "warning"
        }
      ]
    },
    "flight_phase_mix": {
      "enabled": true,
      "triggers": [
        {
          "type": "baseline_deviation",
          "n_min": 10,
          "severity": "watch"
        }
      ]
    },
    "limit_exceedances": {
      "enabled": true,
      "triggers": [
        {
          "type": "threshold",
          "condition": "any_exceedance",
          "severity": "limit"
        }
      ]
    },
    "climb_thermal_rate": {
      "enabled": true,
      "triggers": [
        {
          "type": "baseline_deviation",
          "n_min": 10,
          "severity": "watch"
        }
      ]
    }
  }
}
