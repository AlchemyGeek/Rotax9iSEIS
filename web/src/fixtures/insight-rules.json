{
  "version": "1.6",
  "rules": {
    "egt_spread": {
      "enabled": true,
      "triggers": [
        {
          "type": "baseline_deviation",
          "n_min": 10,
          "severity": "watch"
        },
        {
          "type": "trend",
          "direction": "increasing",
          "r2_min": 0.5,
          "n_min": 10,
          "severity": "watch"
        }
      ]
    },
    "egt_cyl_deviation": {
      "enabled": true,
      "applies_to": [
        "egt1_deviation",
        "egt2_deviation",
        "egt3_deviation",
        "egt4_deviation"
      ],
      "triggers": [
        {
          "type": "baseline_deviation",
          "n_min": 10,
          "severity": "watch"
        },
        {
          "type": "trend",
          "direction": "either",
          "r2_min": 0.5,
          "n_min": 10,
          "severity": "watch"
        }
      ]
    },
    "cylinder_rank": {
      "enabled": false,
      "_comment": "Retired as an insight (Spec 10 D4): egt_cyl_deviation fires first on the same event. Rank stays as context — see Spec 08 §6.",
      "margin_min_f": 15,
      "consecutive_flights": 2
    },
    "oil_temp_peak": {
      "enabled": true,
      "limit_refs": [
        "oil_temp_max"
      ],
      "triggers": [
        {
          "type": "baseline_deviation",
          "n_min": 10,
          "severity": "watch"
        }
      ]
    },
    "coolant_temp_peak": {
      "enabled": true,
      "limit_refs": [
        "coolant_temp_max"
      ],
      "triggers": [
        {
          "type": "baseline_deviation",
          "n_min": 10,
          "severity": "watch"
        }
      ]
    },
    "overboost_time": {
      "_comment": "v0.12 (Spec 09 §6.4/§10.3): the threshold trigger is removed — a block past the limit is now an ordinary limit_exceedances event. This topic only reports the close call, which isn't rule-driven (no trigger needed for it). v0.13 (Spec 10 §4.1): limit_refs drives the mirrored badge, the same mechanism oil_temp_peak/coolant_temp_peak use.",
      "enabled": true,
      "limit_refs": [
        "overboost"
      ],
      "triggers": []
    },
    "map_at_takeoff": {
      "enabled": true,
      "triggers": [
        {
          "type": "threshold",
          "condition": "vs_om_expected",
          "tolerance_hpa": 20,
          "severity": "warning"
        }
      ]
    },
    "engine_ecu_inflight": {
      "enabled": true,
      "triggers": [
        {
          "type": "threshold",
          "condition": "any_inflight",
          "severity": "warning"
        }
      ]
    },
    "limit_exceedances": {
      "enabled": true,
      "triggers": [
        {
          "type": "threshold",
          "condition": "any_exceedance",
          "severity": "limit"
        }
      ]
    },
    "climb_thermal_rate": {
      "enabled": false,
      "_comment": "Research (Spec 10 D2): fails A7; metrics still computed for research. Not shown to casual users.",
      "triggers": [
        {
          "type": "baseline_deviation",
          "n_min": 10,
          "severity": "watch"
        }
      ]
    }
  }
}
