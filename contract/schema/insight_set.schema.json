{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slingologyeis.dev/contract/schema/insight_set.schema.json",
  "title": "InsightSet",
  "description": "Spec 01 (Engine Contract) Section 8.5 — the result of evaluate_insights. Deviates from the section's illustrative sketch in one place: each TopicResult carries `insights` (a list), not a single nullable `insight` — real topics can trigger more than one insight at once (e.g. both a baseline_deviation and a trend insight together), matching what the text report actually prints.",
  "type": "object",
  "required": ["flight_id", "analysis_key", "fleet_key", "rules_hash", "topics", "header_warnings", "provenance"],
  "additionalProperties": false,
  "properties": {
    "flight_id": { "type": "string" },
    "analysis_key": { "type": "string" },
    "fleet_key": { "type": "string" },
    "rules_hash": { "type": "string" },
    "filters_hash": { "type": "string", "description": "Spec 09 §11.2: hash of the limit filters applied." },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic_id", "analysis", "insights", "metric_ids"],
        "additionalProperties": false,
        "properties": {
          "topic_id": { "type": "string" },
          "analysis": {
            "type": "object",
            "required": ["text"],
            "properties": { "text": { "type": "string" } }
          },
          "insights": { "type": "array", "items": { "$ref": "#/$defs/insight" } },
          "metric_ids": { "type": "array", "items": { "type": "string" } },
          "enabled": {
            "type": "boolean",
            "description": "Spec 14 §7.3 — the topic's enabled flag from rules/active.json, shown and editable on the topic card (the disable-topic silencing level)."
          },
          "trigger_status": {
            "type": "array",
            "description": "Spec 14 §7.3 — one entry per configured trigger on this topic, whether or not it fired, for the topic card's triggers disclosure.",
            "items": {
              "type": "object",
              "required": ["type", "met"],
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "enum": ["threshold", "baseline_deviation", "trend"] },
                "met": { "type": ["boolean", "null"], "description": "null when there isn't enough data to evaluate." },
                "detail": { "type": ["string", "null"], "description": "e.g. \"1.2 std devs above all your flights, n=41\" or \"R² 0.30 over 23 flights\"." }
              }
            }
          },
          "limit_refs": {
            "type": "array",
            "description": "Spec 10 §4.1 (Spec 01 §8.5): the rule's limit_refs, each resolved to this flight's limit_exceedances insight for that limit, or null if none fired. Drives the mirrored badge (Spec 03 §5.2); never an insight of its own.",
            "items": {
              "type": "object",
              "required": ["limit_id", "insight_id"],
              "additionalProperties": false,
              "properties": {
                "limit_id": { "type": "string" },
                "insight_id": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "header_warnings": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "provenance": {
      "type": "object",
      "required": ["engine_version", "rules_hash", "source_keys"],
      "properties": {
        "engine_version": { "type": "string" },
        "schema_version": { "type": ["string", "null"] },
        "engine_profile": { "type": ["object", "null"] },
        "params_hash": { "type": ["string", "null"] },
        "rules_hash": { "type": "string" },
        "source_keys": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "insight": {
      "type": "object",
      "required": ["id", "topic_id", "rule_id", "trigger", "severity", "message", "evidence", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "topic_id": { "type": "string" },
        "rule_id": { "type": "string" },
        "trigger": { "type": "string", "enum": ["threshold", "baseline_deviation", "trend"] },
        "severity": { "type": "string", "enum": ["info", "watch", "warning", "limit"] },
        "message": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string" },
            "values": {
              "type": "object",
              "properties": {
                "comparison": {
                  "type": "object",
                  "required": ["scope", "n"],
                  "properties": {
                    "scope": { "type": "string", "enum": ["band", "all"] },
                    "band": { "type": ["string", "null"] },
                    "n": { "type": "integer" }
                  }
                }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string", "enum": ["metric", "baseline_point", "series_window", "exceedance", "ecu_run"] }
            }
          }
        },
        "confidence": {
          "type": "object",
          "required": ["level", "n"],
          "properties": {
            "level": { "type": "string", "enum": ["VERY_LOW", "LOW", "MODERATE", "GOOD"] },
            "n": { "type": "integer" }
          }
        },
        "note": { "type": "string" },
        "limit_id": { "type": "string", "description": "Spec 09 §11.3: set on limit_exceedances insights." },
        "filterable": { "type": "boolean", "description": "Spec 09 §6.3: whether this insight's limit can be filtered." },
        "filter": {
          "type": "object",
          "required": ["filter_id", "outcome"],
          "properties": {
            "filter_id": { "type": "string" },
            "outcome": { "type": "string", "enum": ["suppressed", "breach"] }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event_id", "elapsed_s", "duration_s", "observed_value", "excess", "suppressed_by"],
            "properties": {
              "event_id": { "type": "string" },
              "start_utc": { "type": "string" },
              "elapsed_s": { "type": ["number", "null"] },
              "duration_s": { "type": "number" },
              "observed_value": { "type": "number" },
              "excess": { "type": ["number", "null"] },
              "suppressed_by": { "enum": ["magnitude", "duration", null] }
            }
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "scope", "message"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warn", "error"] },
        "scope": { "type": "string", "enum": ["file", "flight", "fleet", "topic"] },
        "message": { "type": "string" },
        "refs": { "type": "object" }
      }
    }
  }
}
