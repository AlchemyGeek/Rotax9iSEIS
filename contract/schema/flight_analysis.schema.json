{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slingologyeis.dev/contract/schema/flight_analysis.schema.json",
  "title": "FlightAnalysis",
  "description": "Spec 01 (Engine Contract) Section 8.3 — the result of analyze_flight.",
  "type": "object",
  "required": [
    "flight_id", "analysis_key", "source_keys", "header", "phases",
    "metrics", "exceedances", "cas_events", "ecu_runs", "quality", "provenance",
    "available_channels"
  ],
  "additionalProperties": false,
  "properties": {
    "flight_id": { "type": "string" },
    "analysis_key": { "type": "string" },
    "source_keys": { "type": "array", "items": { "type": "string" } },
    "header": {
      "type": "object",
      "required": ["date", "start_utc"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string" },
        "start_utc": { "type": "string" },
        "engine_hours_start": { "type": ["number", "null"] },
        "engine_hours_end": { "type": ["number", "null"] },
        "airport_hint": { "type": ["string", "null"] },
        "aircraft": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ident": { "type": ["string", "null"] },
            "system_id": { "type": ["string", "null"] }
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "start_s", "end_s"],
        "additionalProperties": false,
        "properties": {
          "phase": { "type": "string" },
          "start_s": { "type": "number" },
          "end_s": { "type": "number" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/metricValue" }
    },
    "exceedances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["param", "label", "unit", "severity", "limit_type", "limit_value", "observed_value", "start_utc", "elapsed_s", "duration_s"],
        "properties": {
          "param": { "type": "string" },
          "label": { "type": "string" },
          "unit": { "type": "string" },
          "severity": { "type": "string" },
          "limit_type": { "type": "string", "enum": ["MIN", "MAX"] },
          "limit_value": { "type": "number" },
          "observed_value": { "type": "number" },
          "start_utc": { "type": "string" },
          "elapsed_s": { "type": ["number", "null"] },
          "duration_s": { "type": "number" },
          "note": { "type": "string" },
          "limit_id": { "type": ["string", "null"], "description": "Spec 09 §6.1: the limit's stable id." },
          "event_id": { "type": "string", "description": "Spec 09 §11.1: limit_id@start_utc." },
          "excess": { "type": ["number", "null"], "description": "Spec 09 §4: how far past the limit, in engine units." }
        }
      }
    },
    "cas_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alert", "severity", "start_utc", "elapsed_s", "duration_s", "rows", "started_before_engine"],
        "properties": {
          "alert": { "type": "string" },
          "severity": { "type": "string" },
          "start_utc": { "type": "string" },
          "elapsed_s": { "type": ["number", "null"] },
          "duration_s": { "type": "number" },
          "rows": { "type": "integer" },
          "started_before_engine": { "type": "boolean" }
        }
      }
    },
    "ecu_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["classification", "phase", "phase_uncertain", "start_utc", "elapsed_s", "duration_s", "co_alerts", "oil_nan_frac", "lane_check_pair", "lane_check_note"],
        "properties": {
          "classification": { "type": "string", "enum": ["GROUND_START", "LANE_CHECK", "GROUND", "IN_FLIGHT", "GROUND_SHUTDOWN"], "description": "Spec 01 §8.6 (v0.19): by the flight phase the run overlaps." },
          "phase": { "type": "string", "description": "The flight phase that decided the classification." },
          "phase_uncertain": { "type": "boolean", "description": "Phase came from UNKNOWN rows, or the finding-9 guard reclassified the run IN_FLIGHT." },
          "start_utc": { "type": ["string", "null"] },
          "elapsed_s": { "type": ["number", "null"] },
          "duration_s": { "type": "number" },
          "co_alerts": { "type": "array", "items": { "type": "string" } },
          "oil_nan_frac": { "type": ["number", "null"] },
          "lane_check_pair": { "type": "boolean" },
          "lane_check_note": { "type": "string" },
          "mean_rpm": { "type": ["number", "null"] },
          "mean_ias_kt": { "type": ["number", "null"] }
        }
      }
    },
    "ecu_sub_threshold_blips": {
      "type": "integer",
      "description": "Spec 01 §8.6 (v0.19): ENGINE ECU runs shorter than the profile's cas.min_event_duration_s after merging — counted, not runs."
    },
    "ecu_lane_check": {
      "type": "string", "enum": ["both", "single", "none"],
      "description": "Spec 01 §8.6 (v0.19): this flight's lane check — a paired LANE_CHECK, a single one, or none."
    },
    "quality": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "available_channels": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Spec 07 §5: chartable registry ids present in this flight's log and not entirely NaN."
    },
    "limits": {
      "type": "array",
      "description": "Spec 09: the engine profile's limit catalogue this flight was checked against (limits.limit_catalog). Absent or empty for analyses written before Spec 09.",
      "items": {
        "type": "object",
        "required": ["id", "param", "label", "unit", "limit_type", "limit_value", "severity"],
        "properties": {
          "id": { "type": "string" },
          "param": { "type": "string" },
          "label": { "type": "string" },
          "unit": { "type": "string" },
          "limit_type": { "type": "string", "enum": ["MIN", "MAX"] },
          "limit_value": { "type": "number" },
          "severity": { "type": "string" },
          "report_in_exceedances": { "type": "boolean" },
          "stratify_by": { "type": ["string", "null"] },
          "filter_policy": { "type": "object" },
          "close_call_margin_s": { "type": "number" }
        }
      }
    },
    "hot_cyl_changed": {
      "type": "boolean",
      "description": "Spec 08 v0.3 §6 (Spec 10 D4): fleet-dependent context flag, set by evaluate_insights() from FleetAnalysis.cylinder_balance — not an insight. Absent or false for analyses written before Spec 10 Phase A."
    }
  },
  "$defs": {
    "missingReason": {
      "type": "string",
      "enum": ["NO_PHASE", "CHANNEL_MISSING", "INSUFFICIENT_DATA", "NOT_APPLICABLE", "EXCLUDED"]
    },
    "metricValue": {
      "type": "object",
      "required": ["id", "value"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "value": {
          "type": ["number", "boolean", "string", "null", "array"],
          "items": { "type": "integer" },
          "description": "Arrays only for list-valued metrics, e.g. egt_rank_order (cylinder numbers, hottest first; Spec 08 §4)."
        },
        "unit": { "type": "string" },
        "missing": { "$ref": "#/$defs/missingReason" },
        "window": {
          "type": "object",
          "properties": {
            "phase": { "type": "string" },
            "start_s": { "type": "number" },
            "end_s": { "type": "number" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "null" } }, "required": ["value"] },
          "then": { "required": ["missing"] }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "scope", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INGEST_UNKNOWN_FORMAT", "INGEST_GROUND_SESSION", "INGEST_DUPLICATE_OF",
            "INGEST_MULTI_POWER_CYCLE", "INGEST_MISSING_CHANNEL", "INGEST_SIGNAL_GAP",
            "PHASE_TAKEOFF_NOT_DETECTED", "PHASE_NO_CLIMB", "PHASE_NO_CRUISE",
            "BASELINE_LOW_N", "MODEL_INSUFFICIENT_DATA",
            "ENGINE_PLACEHOLDER_CONFIG", "ENGINE_CUSTOM_OVERRIDE"
          ]
        },
        "severity": { "type": "string", "enum": ["info", "warn", "error"] },
        "scope": { "type": "string", "enum": ["file", "flight", "fleet", "topic"] },
        "message": { "type": "string" },
        "refs": { "type": "object" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["engine_version", "schema_version", "engine_profile", "params_hash", "source_keys"],
      "additionalProperties": false,
      "properties": {
        "engine_version": { "type": "string" },
        "schema_version": { "type": "string" },
        "engine_profile": {
          "type": "object",
          "required": ["id", "hash", "source_status"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "hash": { "type": "string" },
            "source_status": { "type": "string", "enum": ["VERIFIED", "PLACEHOLDER", "CUSTOM"] }
          }
        },
        "params_hash": { "type": "string" },
        "rules_hash": { "type": "string" },
        "source_keys": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
