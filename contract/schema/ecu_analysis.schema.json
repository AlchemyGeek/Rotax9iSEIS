{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slingologyeis.dev/contract/schema/ecu_analysis.schema.json",
  "title": "EcuAnalysis",
  "description": "Spec 01 (Engine Contract) Section 8.6 (v0.19) — the result of analyze_ecu. ENGINE ECU runs are classified by the flight phase they overlap.",
  "type": "object",
  "required": ["flight_ids", "runs", "counts", "sub_threshold_blips", "flights", "events", "provenance"],
  "additionalProperties": false,
  "$defs": {
    "classification": { "type": "string", "enum": ["GROUND_START", "LANE_CHECK", "GROUND", "IN_FLIGHT", "GROUND_SHUTDOWN"] },
    "counts": {
      "type": "object",
      "description": "Runs per classification — every class present, zero where none.",
      "required": ["GROUND_START", "LANE_CHECK", "GROUND", "IN_FLIGHT", "GROUND_SHUTDOWN"],
      "additionalProperties": false,
      "properties": {
        "GROUND_START": { "type": "integer" },
        "LANE_CHECK": { "type": "integer" },
        "GROUND": { "type": "integer" },
        "IN_FLIGHT": { "type": "integer" },
        "GROUND_SHUTDOWN": { "type": "integer" }
      }
    }
  },
  "properties": {
    "flight_ids": { "type": "array", "items": { "type": "string" } },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flight_id", "classification", "phase", "phase_uncertain", "duration_s", "co_alerts", "lane_check_pair", "lane_check_note", "context"],
        "properties": {
          "flight_id": { "type": "string" },
          "classification": { "$ref": "#/$defs/classification" },
          "phase": { "type": "string", "description": "The flight phase that decided the classification (UNKNOWN rows take the nearest preceding known phase)." },
          "phase_uncertain": { "type": "boolean", "description": "The phase came from UNKNOWN rows, or the finding-9 guard reclassified the run IN_FLIGHT." },
          "start_utc": { "type": ["string", "null"] },
          "end_utc": { "type": ["string", "null"] },
          "duration_s": { "type": "number" },
          "co_alerts": { "type": "array", "items": { "type": "string" } },
          "lane_check_pair": { "type": "boolean" },
          "lane_check_note": { "type": "string" },
          "context": {
            "type": "object",
            "description": "Per-run channel means, incl. oil_nan_frac — what a co-active-alert correlation (e.g. B3's OIL PRESS check) is actually judged against, not just classification/timing.",
            "properties": {
              "mean_rpm": { "type": ["number", "null"] },
              "mean_power_pct": { "type": ["number", "null"] },
              "mean_oil_press_psi": { "type": ["number", "null"] },
              "mean_oil_temp_f": { "type": ["number", "null"] },
              "mean_coolant_temp_f": { "type": ["number", "null"] },
              "mean_main_volts": { "type": ["number", "null"] },
              "mean_batt_amps": { "type": ["number", "null"] },
              "mean_fuel_press_psi": { "type": ["number", "null"] },
              "mean_ias_kt": { "type": ["number", "null"] },
              "mean_baro_alt_ft": { "type": ["number", "null"] },
              "oil_nan_frac": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "counts": { "$ref": "#/$defs/counts" },
    "sub_threshold_blips": {
      "type": "integer",
      "description": "ENGINE ECU runs shorter than the profile's cas.min_event_duration_s after merging, across all flights — data quality only, not events."
    },
    "flights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flight_id", "counts", "sub_threshold_blips", "lane_check"],
        "additionalProperties": false,
        "properties": {
          "flight_id": { "type": "string" },
          "counts": { "$ref": "#/$defs/counts" },
          "sub_threshold_blips": { "type": "integer" },
          "lane_check": { "type": "string", "enum": ["both", "single", "none"] }
        }
      }
    },
    "events": {
      "type": "array",
      "description": "Per-event co-active alerts for every GROUND and IN_FLIGHT run (BACKLOG B3) — never a pooled table.",
      "items": {
        "type": "object",
        "required": ["flight_id", "classification", "start_utc", "duration_s", "phase", "phase_uncertain", "co_alerts", "oil_nan_frac"],
        "additionalProperties": false,
        "properties": {
          "flight_id": { "type": "string" },
          "classification": { "type": "string", "enum": ["GROUND", "IN_FLIGHT"] },
          "start_utc": { "type": ["string", "null"] },
          "duration_s": { "type": "number" },
          "phase": { "type": "string" },
          "phase_uncertain": { "type": "boolean" },
          "co_alerts": { "type": "array", "items": { "type": "string" } },
          "oil_nan_frac": { "type": ["number", "null"] }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["engine_version", "source_keys", "flight_analysis_keys"],
      "properties": {
        "engine_version": { "type": "string" },
        "schema_version": { "type": ["string", "null"] },
        "source_keys": { "type": "array", "items": { "type": "string" } },
        "flight_analysis_keys": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
